#!/bin/bash
# jarvis-install: bin
# jarvis-update  |  PROJECT RIMA, RIMA-01
# Installs J.A.R.V.I.S. files you downloaded.
#
# Each file says where it belongs in one of its first 5 lines:
#     # jarvis-install: .        ->  ~/rima/jarvis/
#     # jarvis-install: tools    ->  ~/rima/jarvis/tools/
#     # jarvis-install: bin      ->  ~/rima/jarvis/bin/      (+ a link in ~/.local/bin)
#     # jarvis-install: systemd  ->  ~/rima/jarvis/systemd/  (+ a link in ~/.config/systemd/user)
#     # jarvis-install: polybar  ->  ~/rima/jarvis/polybar/
# so new files need no changes to this script. Files written before this system
# (voice.py, jarvis, jarvis-ptt) are listed in LEGACY below.
#
# For each file it:
#   * picks the newest download, even if the browser renamed it "name (1).py"
#   * checks it for mistakes (Python syntax, bash syntax, TOML format)
#   * backs up the installed version, then swaps the new one in
# Undo: old versions are in ~/rima/jarvis/.backups/<date-time>/, and git has the history.
set -u

DOWNLOADS="$HOME/Downloads"
JARVIS_DIR="$HOME/rima/jarvis"
BIN_DIR="$HOME/.local/bin"
UNIT_DIR="$HOME/.config/systemd/user"
VOICE_UNIT="jarvis-voice"
BACKUP_DIR="$JARVIS_DIR/.backups/$(date +%Y-%m-%d_%H%M%S)"

# Files without an install line: file name -> destination
declare -A LEGACY=(
    [jarvis.py]="."
    [voice.py]="."
    [jarvis]="bin"
    [jarvis-ptt]="bin"
)

# The only destinations allowed. Anything else in an install line is refused,
# so a file can't put itself somewhere like ~/.bashrc.
dest_dir() {
    case "$1" in
        .)       echo "$JARVIS_DIR" ;;
        tools)   echo "$JARVIS_DIR/tools" ;;
        bin)     echo "$JARVIS_DIR/bin" ;;
        systemd) echo "$JARVIS_DIR/systemd" ;;
        polybar) echo "$JARVIS_DIR/polybar" ;;
        *)     return 1 ;;
    esac
}

# "tasks (2).py" -> "tasks.py"; "jarvis-update (1)" -> "jarvis-update"
canonical() {
    if [[ "$1" =~ ^(.+)\ \([0-9]+\)(\.[^.]+)?$ ]]; then
        echo "${BASH_REMATCH[1]}${BASH_REMATCH[2]}"
    else
        echo "$1"
    fi
}

# Prints the destination from a "# jarvis-install: <where>" line, if there is one
install_line() {
    head -n 5 -- "$1" 2>/dev/null \
        | sed -n 's/^#[[:space:]]*jarvis-install:[[:space:]]*\([^[:space:]]*\)[[:space:]]*$/\1/p' \
        | head -n 1
}

# Checks a file for mistakes before it's installed. $1 = file, $2 = name, $3 = destination
check_file() {
    case "$2" in
        *.py)
            python3 -I - "$1" <<'EOF'
import ast, sys
try:
    ast.parse(open(sys.argv[1]).read(), sys.argv[1])
except SyntaxError as e:
    print(f"  line {e.lineno}: {e.msg}")
    sys.exit(1)
EOF
            ;;
        *.toml)
            python3 -I - "$1" <<'EOF'
import sys, tomllib
try:
    tomllib.load(open(sys.argv[1], "rb"))
except tomllib.TOMLDecodeError as e:
    print(f"  {e}")
    sys.exit(1)
EOF
            ;;
        *.sh) bash -n "$1" ;;
        *.service|*.timer)
            if ! grep -qE '^\[(Service|Timer)\]' "$1"; then
                echo "  no [Service] or [Timer] section"
                return 1
            fi
            ;;
        *)    if [[ "$3" == bin ]]; then bash -n "$1"; fi ;;
    esac
}

# Makes <folder>/<name> a link to the copy in the project folder, so it keeps
# working where the system looks for it while git tracks the real file.
# Used for commands (~/.local/bin) and services (~/.config/systemd/user).
link_into() {
    local folder="$1" name="$2" target="$3" link="$1/$2"
    if [[ -L "$link" && "$(readlink -- "$link")" == "$target" ]]; then
        return
    fi
    mkdir -p "$folder"
    if [[ -e "$link" && ! -L "$link" ]]; then
        mkdir -p "$BACKUP_DIR/replaced-links"
        mv -- "$link" "$BACKUP_DIR/replaced-links/$name"
        echo "moved    old ${link/#$HOME/\~} to the backup folder"
    fi
    ln -sfn -- "$target" "$link"
    echo "linked   ${link/#$HOME/\~} -> ${target/#$HOME/\~}"
}

# ---------------------------------------------------------------------------
# 1. Find J.A.R.V.I.S. files in Downloads, newest first
# ---------------------------------------------------------------------------
declare -A chosen=()   # file name -> newest download
declare -A where=()    # file name -> destination
declare -A copies=()   # file name -> every download of it (one per line)
order=()

while IFS= read -r -d '' entry; do
    path="${entry#* }"
    name="$(canonical "$(basename -- "$path")")"
    copies[$name]+="$path"$'\n'          # every copy, so older ones get cleared too
    key="$(install_line "$path")"
    [[ -z "$key" ]] && key="${LEGACY[$name]:-}"
    [[ -z "$key" ]] && continue          # not a J.A.R.V.I.S. file
    if [[ -z "${chosen[$name]:-}" ]]; then
        chosen[$name]="$path"
        where[$name]="$key"
        order+=("$name")
    fi
done < <(find "$DOWNLOADS" -maxdepth 1 -type f -size -1024k -printf '%T@ %p\0' 2>/dev/null \
         | LC_ALL=C sort -z -rn)

# ---------------------------------------------------------------------------
# 2. Check and install each one
# ---------------------------------------------------------------------------
installed=()
for name in "${order[@]}"; do
    src="${chosen[$name]}"
    key="${where[$name]}"

    if ! dir="$(dest_dir "$key")"; then
        echo "SKIPPED  $name says to install into '$key', which isn't allowed (use . tools bin systemd or polybar)."
        continue
    fi
    if ! check_file "$src" "$name" "$key"; then
        echo "SKIPPED  $name has a mistake; kept the current version."
        continue
    fi

    dest="$dir/$name"
    if [[ -f "$dest" ]] && cmp -s -- "$src" "$dest"; then
        echo "same     $name (already installed)"
    else
        if [[ -f "$dest" ]]; then
            mkdir -p "$BACKUP_DIR/$key"
            cp -p -- "$dest" "$BACKUP_DIR/$key/$name"
        fi
        mkdir -p -- "$dir"
        # Copy to a temporary name, then rename over the old file. The swap is
        # instant, and a script that is running (even this one) keeps reading
        # its old copy instead of getting changed halfway through.
        cp -- "$src" "$dest.new"
        [[ "$key" == bin ]] && chmod +x "$dest.new"
        mv -f -- "$dest.new" "$dest"
        installed+=("$key/$name")
        echo "updated  $name -> ${dir/#$HOME/\~}"
    fi
    [[ "$key" == bin ]] && link_into "$BIN_DIR" "$name" "$dest"
    [[ "$key" == systemd ]] && link_into "$UNIT_DIR" "$name" "$dest"

    # Clear this file's downloads so the next update starts clean
    mapfile -t old < <(printf '%s' "${copies[$name]}")
    rm -f -- "${old[@]}"
done

if [[ ${#installed[@]} -eq 0 ]]; then
    echo "Nothing new to install from ${DOWNLOADS/#$HOME/\~}."
    exit 0
fi

[[ -d "$BACKUP_DIR" ]] && echo "Old versions saved in ${BACKUP_DIR/#$HOME/\~}"
echo "See what changed:  cd ~/rima/jarvis && git status && git diff"

# ---------------------------------------------------------------------------
# 3. Let systemd see new service files, then reload or restart voice mode
# ---------------------------------------------------------------------------
for f in "${installed[@]}"; do
    if [[ "$f" == systemd/* ]]; then
        systemctl --user daemon-reload && echo "systemd  re-read the service files"
        break
    fi
done

needs_restart=false
for f in "${installed[@]}"; do
    case "$f" in
        tools/__init__.py) needs_restart=true ;;    # the toolbox itself: a reload can't swap it
        tools/*|./config.toml|bin/*|polybar/*) ;;   # picked up without a restart
        *) needs_restart=true ;;
    esac
done

# Running as a service: restart it automatically if needed.
if systemctl --user is-active --quiet "$VOICE_UNIT" 2>/dev/null && $needs_restart; then
    systemctl --user restart "$VOICE_UNIT" && echo "Restarted voice mode to load the changes."
    exit 0
fi

pid_file="${XDG_RUNTIME_DIR:-/tmp}/jarvis.pid"
[[ -f "$pid_file" ]] || exit 0
pid="$(cat "$pid_file")"
# Only signal it if that PID really is J.A.R.V.I.S. (a stale PID file could point
# at some other program, and the signal would close it).
if [[ "$pid" =~ ^[0-9]+$ ]] && kill -0 "$pid" 2>/dev/null \
        && grep -qa "jarvis.py" "/proc/$pid/cmdline" 2>/dev/null; then
    if $needs_restart; then
        echo "Voice mode is running in a terminal. Restart it (Ctrl+C there, then press the talk key) to load the changes."
    else
        kill -USR2 "$pid" && echo "Voice mode is running; told it to reload its tools."
    fi
fi
