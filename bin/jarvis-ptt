#!/bin/bash
# ~/.local/bin/jarvis-ptt  |  PROJECT RIMA, RIMA-01
# Push-to-talk: tells a running `jarvis --voice` to start listening.
# Bound to a key in i3.
pid_file="${XDG_RUNTIME_DIR:-/tmp}/jarvis.pid"

if [[ -f "$pid_file" ]] && kill -USR1 "$(cat "$pid_file")" 2>/dev/null; then
    exit 0
fi

notify-send -a "J.A.R.V.I.S." "Voice mode isn't running" "Start it with: jarvis --voice"
exit 1
