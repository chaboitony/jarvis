#!/bin/bash
# ~/.local/bin/jarvis  |  PROJECT RIMA, RIMA-01
# Start J.A.R.V.I.S. from anywhere:
#   jarvis            typed commands
#   jarvis --voice    push-to-talk voice mode
# Add --window when launching in its own terminal (rofi, i3) so errors stay visible.
JARVIS_DIR="$HOME/rima/jarvis"

window=0
args=()
for arg in "$@"; do
    if [[ "$arg" == "--window" ]]; then
        window=1
    else
        args+=("$arg")
    fi
done
# Use the downloaded Whisper model; never contact Hugging Face. To download a
# new model once, run with HF_HUB_OFFLINE=0 in front (see config.toml [voice]).
export HF_HUB_OFFLINE="${HF_HUB_OFFLINE:-1}"
cd "$JARVIS_DIR" || { echo "Can't find $JARVIS_DIR"; exit 1; }

# GPU Whisper: if CUDA 12's cuBLAS is installed in the venv (uv add nvidia-cublas-cu12),
# let the speech recognizer find it. Does nothing otherwise.
for lib in .venv/lib/python3*/site-packages/nvidia/*/lib; do
    [[ -d "$lib" ]] && export LD_LIBRARY_PATH="$JARVIS_DIR/$lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
done
uv run jarvis.py "${args[@]}"
status=$?

if [[ $window -eq 1 && $status -ne 0 ]]; then
    read -rp "J.A.R.V.I.S. exited with an error (code $status). Press Enter to close."
fi
exit $status
